{
  "name": "alexandrite-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:purescript": "purescript-alexandrite build",
    "build:playground": "node scripts/build-playground-packages.mjs && node scripts/build-playground-runtime.mjs && node scripts/build-playground-wasm.mjs && node scripts/build-playground-assets.mjs",
    "build": "pnpm build:playground && pnpm build:purescript && astro build",
    "watch:purescript": "purescript-alexandrite watch --output output",
    "dev": "pnpm build:playground && pnpm build:purescript && concurrently --kill-others --names compiler,astro --prefix-colors cyan,magenta \"pnpm watch:purescript\" \"astro dev\"",
    "test:playground": "node --test src/Website/Playground/*.test.js playground/packages/*.test.mjs",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "sources": "spago sources"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.5",
    "@astrojs/react": "6.0.4",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/oxanium": "5.3.0",
    "@stylexjs/stylex": "0.19.0",
    "acorn": "8.15.0",
    "astro": "7.2.9",
    "inter-ui": "4.1.1",
    "monaco-editor": "0.55.1",
    "react": "18.3.1",
    "react-aria-components": "1.20.0",
    "react-dom": "18.3.1",
    "wrangler": "4.126.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.126",
    "@iconify-json/simple-icons": "1.2.93",
    "@stylexjs/unplugin": "0.19.0",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "purescript": "0.15.16",
    "purs-tidy": "0.11.1",
    "spago": "1.0.4",
    "unplugin-icons": "23.0.1",
    "vite": "8.2.2"
  },
  "packageManager": "pnpm@12.3.4"
}
