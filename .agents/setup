#!/usr/bin/env bash
set -euo pipefail

SECONDS=0
printf 'Installing Node.js and pnpm…\n'
export PATH="$HOME/.local/share/fnm:$PATH"

if ! command -v fnm >/dev/null 2>&1; then
  curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell
fi

eval "$(fnm env --shell bash)"
fnm install 22
fnm use 22
fnm default 22

if [[ $("$HOME/.local/share/fnm/aliases/default/bin/pnpm" --version 2>/dev/null || true) != 12.3.4 ]]; then
  npm install --global pnpm@12.3.4
fi

install -d "$HOME/.local/bin"
ln -sfn "$HOME/.local/share/fnm/aliases/default/bin/node" "$HOME/.local/bin/node"
ln -sfn "$HOME/.local/share/fnm/aliases/default/bin/pnpm" "$HOME/.local/bin/pnpm"
export PATH="$HOME/.local/bin:$PATH"
hash -r

export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"
printf 'Preparing release compiler toolchains (%ss elapsed)…\n' "$SECONDS"

if ! command -v rustup >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain stable
fi

rustup toolchain install stable --profile minimal
rustup default stable
rustup target add wasm32-unknown-unknown

if [[ $(wasm-bindgen --version 2>/dev/null || true) != "wasm-bindgen 0.2.127" ]]; then
  if ! command -v cargo-binstall >/dev/null 2>&1; then
    curl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh \
      | bash
  fi
  cargo binstall wasm-bindgen-cli --version 0.2.127 --locked --no-confirm
fi

.amp/with-alexandrite purescript-alexandrite --version
pnpm install --frozen-lockfile

printf 'Building production website and release WASM (%ss elapsed)…\n' "$SECONDS"
.amp/with-alexandrite pnpm build
printf 'Setup complete in %ss. .agents/resume starts the managed website service.\n' "$SECONDS"
